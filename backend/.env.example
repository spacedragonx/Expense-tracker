# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
# Replace <username>, <password>, <cluster>, <dbname> with your Atlas values
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=expense_tracker_token

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# LLM — Google Gemini (required for statement import feature)
GEMINI_API_KEY=your_gemini_api_key_here
# Requests-per-minute ceiling of your Gemini API key/tier. The statement
# parser paces its calls to stay under this so it doesn't burn through a
# small free-tier quota (default: 5, matching the free tier).
GEMINI_RPM_LIMIT=5
